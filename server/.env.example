# ============================================================
# STUDIO SETA — backend environment
# Copy to .env and fill in real values. Without Google credentials
# the API runs in demo mode (file-based calendar) — fully functional.
# ============================================================

# --- HTTP ---
PORT=3001
# Public URL of the API (needed for Google webhook delivery, must be HTTPS in prod)
PUBLIC_BASE_URL=http://localhost:3001
# Frontend origin for OAuth redirect-back
FRONTEND_URL=http://localhost:5173

# --- Studio working hours ---
STUDIO_TIMEZONE=Europe/Moscow
WORK_START_HOUR=10
WORK_END_HOUR=20
SLOT_GRANULARITY_MIN=30

# --- Google Calendar: OAuth 2.0 (owner's Primary calendar) ---
# Google Cloud Console -> Credentials -> OAuth 2.0 Client (Web application)
# Authorized redirect URI must be: <PUBLIC_BASE_URL>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, defaults to <PUBLIC_BASE_URL>/api/oauth/callback
GOOGLE_REDIRECT_URI=
# Usually "primary" — the signed-in owner's main calendar
GOOGLE_CALENDAR_ID=primary

# --- Google Calendar: alternative via Service Account ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=seta-booking@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json

# --- Notifications (email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STUDIO SETA <no-reply@studio-seta.ru>

# --- Notifications (Telegram to owner / SMS fallback stub) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local data storage ---
# DATA_DIR=./.data
